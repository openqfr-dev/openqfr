{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openqfr.dev/schema/qfr/0.1.0",
  "title": "Quant Failure Record (QFR) pilot",
  "description": "Project-local pilot, not an industry standard.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "record_id", "record_type", "source", "scope", "hypothesis", "strategy", "execution_and_validation", "outcome", "evidence", "record_sha256"],
  "properties": {
    "schema": {"const": "QFR"},
    "schema_version": {"const": "0.1.0-pilot"},
    "record_id": {"type": "string", "pattern": "^qfr:[0-9a-f]{24}$"},
    "record_type": {"const": "NEGATIVE_STRATEGY_EVIDENCE"},
    "source": {"type": "object", "required": ["experiment_id", "ledger_sha256", "ledger_line", "result_sha256", "spec_sha256"]},
    "scope": {"type": "object", "required": ["venue", "market_type", "symbol", "data_hashes", "evaluation_period", "period_status"]},
    "hypothesis": {"type": "object"},
    "strategy": {"type": "object", "required": ["direction", "entry_timing", "exit_model", "feature_program", "parameters", "timeframe_roles", "logic_fingerprint"]},
    "execution_and_validation": {"type": "object"},
    "outcome": {"type": "object", "required": ["verdict", "failure_codes", "source_failure_reasons", "scenarios"], "properties": {"verdict": {"const": "FAIL"}, "failure_codes": {"type": "array", "minItems": 1, "uniqueItems": true}}},
    "evidence": {"type": "object", "required": ["assurance", "reproduced_by_site", "no_orders", "known_limitations"]},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
